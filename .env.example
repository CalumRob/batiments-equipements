# Copy to .env and replace paths with the local acquisition/output locations.
# This file contains no data, credentials, or machine-specific output.
BE_DATA_DIR=E:/path/to/local/data
BE_OUTPUT_DIR=E:/path/to/local/data/matrice
BE_RUN_LABEL=full-bretagne-2026-09-04

# A dedicated directory containing exactly one network PBF plus the r5r cache.
BE_NETWORK_DIR=E:/path/to/local/data/acquired/osm/network-bretagne
BE_NETWORK_PBF=E:/path/to/local/data/acquired/osm/bretagne_plus_strip_merged.osm.pbf
BE_NETWORK_IDENTITY_PATH=E:/path/to/local/data/acquired/osm/public-network-identity.rds

BE_MODES=walk,transit,bike,car
BE_CHUNK_SIZE=50000
BE_REROUTE_CHUNK_SIZE=12500
BE_HEAP=-Xmx24G
BE_REROUTE_HEAP=-Xmx12G
BE_N_THREADS=4
BE_DEPARTURE_DATETIME=2026-09-16T08:00:00+0000
BE_TRANSIT_SERVICE_DATE=2026-09-16
BE_ELEVATION=NONE
BE_JAVA_HEAP=4g
BE_USE_CACHE=true
BE_OVERWRITE=false
BE_RESUME=true
BE_VERBOSE=true
